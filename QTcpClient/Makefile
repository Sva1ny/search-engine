####### Compile

connectiondialog.o: connectiondialog.cpp connectiondialog.h \
		ui_connectiondialog.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o connectiondialog.o connectiondialog.cpp

main.o: main.cpp widget.h \
		connectiondialog.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o main.o main.cpp

widget.o: widget.cpp widget.h \
		ui_widget.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o widget.o widget.cpp

qrc_res.o: qrc_res.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o qrc_res.o qrc_res.cpp

moc_connectiondialog.o: moc_connectiondialog.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_connectiondialog.o moc_connectiondialog.cpp

moc_widget.o: moc_widget.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_widget.o moc_widget.cpp

####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/opt/QTcpClient/bin || mkdir -p $(INSTALL_ROOT)/opt/QTcpClient/bin
	$(QINSTALL_PROGRAM) $(QMAKE_TARGET) $(INSTALL_ROOT)/opt/QTcpClient/bin/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/opt/QTcpClient/bin/$(QMAKE_TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/opt/QTcpClient/bin/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

FORCE:

